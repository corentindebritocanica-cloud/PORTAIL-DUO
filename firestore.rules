rules_version = '2';
// Projet Firebase UNIQUE de PORTAIL-DUO (course-app-36e9d) depuis le 29/09/2026.
// Source versionnée : /firestore.rules du dépôt. Publiée par l'API Firebase Rules (voir README racine).
service cloud.firestore {
  match /databases/{database}/documents {

    // Le compte e-mail / mot de passe du duo, et lui seul. Une session anonyme ne suffit PAS :
    // n'importe qui peut en ouvrir une avec la configuration publique du dépôt.
    // Depuis le 29/09/2026 (soir), vaut pour les 4 apps : plus aucune collection ouverte à l'anonyme.
    // Compte reconnu par son UID (identifiant Firebase, fixe) et non plus par son adresse e-mail :
    // l'adresse n'apparaît plus dans ce fichier public (29/09/2026).
    function compteDuo() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.uid == '4WmOzFC9U0a77LcM00xc9kaz4fh2';
    }

    // ---- COURSE + PORTAIL ---- (avant le 29/09/2026 : toute session, anonyme comprise)
    match /produits/{id}       { allow read, write: if compteDuo(); }
    match /rayons/{id}         { allow read, write: if compteDuo(); }
    match /portail/{id}        { allow read, write: if compteDuo(); }
    match /listes/{id}         { allow read, write: if compteDuo(); }   // listes de courses (Maison, Apéro…), 30/09/2026
    // Téléphones abonnés aux notifications (écrit par le Portail, lu par le relais Apps Script
    // avec le compte de service — qui ne passe pas par ces règles), 30/09/2026
    match /notifAbonnes/{id}   { allow read, write: if compteDuo(); }

    // ---- MUSCU ----
    match /archives/{id}       { allow read, write: if compteDuo(); }
    match /customSessions/{id} { allow read, write: if compteDuo(); }
    match /coachChat/{id}      { allow read, write: if compteDuo(); }
    match /settings/{id}       { allow read, write: if compteDuo(); }

    // ---- BUDGET ----
    match /mois/{document=**}   { allow read, write: if compteDuo(); }
    match /config/{document=**} { allow read, write: if compteDuo(); }

    // Tout le reste : fermé. Une nouvelle app = une nouvelle collection déclarée ici.
    match /{document=**} { allow read, write: if false; }
  }
}
